# ─────────────────────────────────────────────────────────────
# IMOTION / Clarivi BUILD — variables d'environnement
#
# Copier ce fichier :
#   - en local           : cp .env.example .env.local
#   - sur le VPS         : cp .env.example .env.production
#
# ⚠️  NE JAMAIS COMMITTER de fichier .env / .env.local / .env.production
#     contenant de vraies valeurs.
# ⚠️  NE JAMAIS METTRE la SUPABASE_SERVICE_ROLE_KEY ici — elle ne doit
#     vivre QUE côté serveur (Edge Functions Supabase, GitHub Actions).
# ─────────────────────────────────────────────────────────────

# ── Frontend (exposées au navigateur via Vite) ───────────────
# Toutes les variables `VITE_*` sont publiques par construction
# (figées dans le bundle au moment du build).

# URL Supabase complète, ex. https://abcd1234.supabase.co
VITE_SUPABASE_URL=

# Clé "anon / publishable" Supabase (publique, jamais la service_role)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Identifiant projet Supabase (sert de fallback pour construire l'URL)
VITE_SUPABASE_PROJECT_ID=

# ── Build / runtime serveur (jamais exposés au front) ────────
# À renseigner UNIQUEMENT côté CI/CD ou panneau Supabase Edge Functions.
# Listés ici pour documentation, NE PAS les définir dans un .env servi
# au navigateur.
#
#   SUPABASE_SERVICE_ROLE_KEY=        # admin DB — secret absolu
#   SUPABASE_DB_URL=                  # connexion psql — secret absolu
#   BREVO_API_KEY=                    # envoi emails transactionnels
#   LOVABLE_API_KEY=                  # AI Gateway Lovable
#   MARKETING_WEBHOOK_SECRET=         # HMAC lovelib → Clarivi
#   LOVELIB_BRIDGE_SECRET=            # SSO bridge token
#   CRON_SECRET=                      # jobs pg_cron
