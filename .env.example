# ─────────────────────────────────────────────────────────────
# IMOTION / Clarivi BUILD — variables d'environnement
#
# Copier ce fichier :
#   - en local           : cp .env.example .env.local
#   - sur le VPS         : cp .env.example .env.production
#
# ⚠️  NE JAMAIS COMMITTER de fichier .env / .env.local / .env.production
#     contenant de vraies valeurs.
# ⚠️  NE JAMAIS METTRE la SUPABASE_SERVICE_ROLE_KEY ici — elle ne doit
#     vivre QUE côté serveur (Edge Functions Supabase, GitHub Actions).
# ─────────────────────────────────────────────────────────────

# ── Frontend (exposées au navigateur via Vite) ───────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# ── LLM Gateway (Edge Functions uniquement — ne pas exposer au front) ────────

# Stratégique : CDC, Devis, Validation qualité (Anthropic Claude Sonnet)
ANTHROPIC_API_KEY=

# Conversationnel : Phases 1-2-3 prospect, hébergé EU, conforme RGPD (Mistral)
# https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Routing & extraction JSON ultra low-cost (Google Gemini Flash)
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Infrastructure serveur ────────────────────────────────────
# SUPABASE_SERVICE_ROLE_KEY=        # admin DB — secret absolu
# SUPABASE_DB_URL=                  # connexion psql — secret absolu

# Email transactionnel
# BREVO_API_KEY=
# RESEND_API_KEY=

# Billing Stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Bridge Lovelib
# BRIDGE_HMAC_SECRET=
# MARKETING_WEBHOOK_SECRET=
# LOVELIB_BRIDGE_SECRET=
# CRON_SECRET=
